{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "database.rules.json",
      "playwright.config.js",
      "database-debug.log",
      "firebase-debug.log",
      "logs/**",
      "test-results/**",
      "playwright-report/**",
      "START_*.bat",
      "*.log",
      "docs/**",
      "scripts/**",
      "local-server*.log",
      "local-emulator*.log",
      "e2e/**",
      ".github/**"
    ]
  },
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "database": {
      "host": "0.0.0.0",
      "port": 9000
    },
    "hosting": {
      "host": "0.0.0.0",
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
